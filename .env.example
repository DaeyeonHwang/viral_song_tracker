# 이 파일을 복사해서 .env 로 저장한 뒤 실제 키를 채워 넣으세요.
# cp .env.example .env

# YouTube Data API v3 키 (Google Cloud Console에서 발급)
YOUTUBE_API_KEY=

# Last.fm API 키 (last.fm/api 에서 발급)
LASTFM_API_KEY=

# YouTube 트렌딩 조회 대상 국가 (첫 번째 값만 사용됨). 해외 차트를 보려면 US, GB 등
YOUTUBE_REGIONS=US

# Last.fm 국가별 차트를 보고 싶으면 국가명(영문), 비워두면 글로벌 차트
LASTFM_COUNTRY=

# true면 제목/아티스트에 한글이 포함된 곡을 결과에서 제외 (해외 곡만 보고 싶을 때)
EXCLUDE_KOREAN=true

# 유튜브 업로드일 기준으로 이 값(일) 이내면 '신곡', 이후면 '역주행'으로 표시
RECENT_SONG_DAYS=90

# true면 MusicBrainz로 곡을 식별해 더 정확하게 매칭 (첫 실행은 느릴 수 있음, 이후 캐싱됨)
USE_MUSICBRAINZ=true

# true면 리액션/커버/스페드업 등 파생 콘텐츠로 보이는 제목을 결과에서 제외
FILTER_DERIVATIVE=true

# true면 Reddit에서 곡 언급량을 조회해 보조 점수로 반영 (--demo에서는 자동으로 꺼짐)
USE_REDDIT=true

# Reddit 공식 OAuth 앱이 승인됐다면 여기 채워 넣으세요 (비워두면 비인증 방식을 시도하지만,
# Reddit이 2026년 5월부터 비인증 요청을 차단하고 있어 대부분 실패합니다)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# 언급량을 확인할 서브레딧 목록 (콤마 구분)
REDDIT_SUBREDDITS=music,popheads,hiphopheads,indieheads

# 최근 며칠간의 언급을 셀지
REDDIT_LOOKBACK_DAYS=7

# 언급 1건당 보너스 점수의 세기 (log 스케일로 더해짐, 값을 낮추면 영향이 줄어듦)
REDDIT_WEIGHT=0.3

# 상위 몇 곡까지만 Reddit 조회를 할지 (많을수록 정확하지만 실행 시간이 늘어남)
REDDIT_CHECK_TOP_N=30

# 관심 아티스트 목록 (콤마 구분). 이 아티스트의 곡이 오늘 트렌딩에 있으면
# 순위와 상관없이 리포트 맨 위 "관심 아티스트 소식"에 따로 보여준다.
WATCHLIST_ARTISTS=

# 장르 필터 (Last.fm 태그 기준, 콤마 구분). 둘 다 비워두면 필터링 안 함.
# GENRE_INCLUDE에 값이 있으면 그 장르만 남기고, GENRE_EXCLUDE의 장르는 항상 제외.
GENRE_INCLUDE=
GENRE_EXCLUDE=

# 상위 몇 곡까지만 장르 태그를 조회할지
GENRE_CHECK_TOP_N=40
